# Mastitis Detection System (MDS) Environment Configuration

# Server Settings
PROJECT_NAME="Mastitis Detection System API"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql+pymysql://mds_user:mds_secure_pass@localhost:3306/mastitis_detection_system"

# Security & JWT Configuration
JWT_SECRET_KEY="super-secret-jwt-key-replace-in-production-mds-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning Artifact Path
ML_MODEL_PATH="models/mastitis_rf_model.joblib"

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGINS="*"
